# Build trees (any name starting with build, plus VS "Open Folder" output)
/build*/
/out/
CMakeUserPresets.json

# IDE / editor state
.vs/
.vscode/
.idea/
*.user

# OS junk
.DS_Store
Thumbs.db

# Large runtime assets - fetch your own (see assets/README.md).
# Remove these lines (or use Git LFS) if you want to version them.
assets/*.hdr
assets/*.glb
assets/*.gltf

# Local dependency installs (Chrono, a local Filament copy, ...)
# third_parties/ そのものは Git サブモジュール（cpp-httplib 等）を含むので
# 無視しない。手動で置くローカルインストール品だけを個別に除外する。
/third_parties/chrono-install/
/third_parties/filament-*/
