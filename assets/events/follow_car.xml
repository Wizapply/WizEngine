<?xml version="1.0" encoding="UTF-8"?>
<!-- 共通イベント（イベントライブラリ）: カメラ追従。シーンからは
     <asset> の <event name="follow_car" file="events/follow_car.xml"/> で参照し、
     追わせたい車体の <body> に <event name="follow_car"/> を付ける。

     「毎フレーム」から 3 つのカメラのアクションへ繋いだもの: 注視点を車へ・
     車の後ろへ回る・距離と仰角。動かすのは Camera 1（target="1"。カメラは
     スロット番号なのでどのシーンでも同じ意味）。other="-1" = 付けた相手 =
     その車なので、番号で物を指すノードは無い（共通化の前提）。要らない項目は
     ワイヤーを外せばマウス操作に戻る（例: 後ろへ回るを外すと、注視点だけ車に
     付いて回り込みは自由）。止めると元の視点へ戻る。Camera 1 のページ
     （または Scene タブの目アイコン）で見る。

     使っているシーン: vehicle.xml / terrain.xml。ここを編集する（ノード
     エディタで開いてシーンを保存する）と、両方のシーンの追従が変わる。 -->
<event name="follow_car">
  <node id="1" type="onUpdate" pos="40 60"/>
  <node id="2" type="cameraLookAt" pos="300 20" target="1" other="-1" height="0.8"/>
  <node id="3" type="cameraBehind" pos="300 130" target="1" other="-1" smooth="0.35"/>
  <node id="4" type="cameraOrbit" pos="300 250" target="1" distance="9" elevation="14"/>
  <wire from="1" to="2"/>
  <wire from="1" to="3"/>
  <wire from="1" to="4"/>
</event>
