      <wire from="14" to="43"/>
      <wire from="11" to="45"/>
      <wire from="14" to="45" port="1"/>
    </formula>
  </asset>
  <worldbody>
    <environment hdr="env/engine_studio.hdr" intensity="30000" skybox="false"/>
    <ground size="5" visual="3" tile="1" roughness="0.8"/>
    <light name="key" type="sun" pos="0 4 2" euler="40 -30 0" intensity="80000" castshadow="true"/>
    <light name="fill" type="point" pos="-0.8 1 1" intensity="20000" falloff="6" castshadow="false"/>
    <camera name="cam0" target="0 0.45 0" azimuth="20" elevation="15" radius="0.85"/>
    <camera name="cam1" target="0 0.45 0" azimuth="0" elevation="0" radius="0.7"/>
    <body name="stand" pos="0 0 0" fixed="true" mass="10">
      <prefab name="stand"/>
    </body>
    <body name="sun" pos="0 0.45 0" mass="1">
      <prefab name="sun_gear"/>
    </body>
    <body name="planet1" pos="0.095 0.45 0" euler="0 0 0" mass="0.4">
      <prefab name="planet_gear"/>
    </body>
    <body name="planet2" pos="0 0.545 0" euler="0 0 90" mass="0.4">
      <prefab name="planet_gear"/>
    </body>
    <body name="planet3" pos="-0.095 0.45 0" euler="0 0 180" mass="0.4">
      <prefab name="planet_gear"/>
    </body>
    <body name="planet4" pos="0 0.355 0" euler="0 0 270" mass="0.4">
      <prefab name="planet_gear"/>
    </body>
    <body name="carrier" pos="0 0.45 0" mass="1.5">
      <prefab name="carrier_frame"/>
    </body>
    <body name="ring" pos="0 0.45 0" mass="2">
      <prefab name="ring_gear"/>
    </body>
  </worldbody>
  <equality>
    <joint name="sun_axle" type="hinge" body1="sun" body2="world" anchor="0 0.45 0" axis="0 0 1" motor="speed" target="0"/>
    <joint name="ring_axle" type="hinge" body1="ring" body2="world" anchor="0 0.45 0" axis="0 0 1" motor="speed" target="0"/>
    <joint name="carrier_axle" type="hinge" body1="carrier" body2="world" anchor="0 0.45 0" axis="0 0 1"/>
    <joint name="planet1_pin" type="hinge" body1="planet1" body2="carrier" anchor="0.095 0.45 0" axis="0 0 1"/>
    <joint name="planet2_pin" type="hinge" body1="planet2" body2="carrier" anchor="0 0.545 0" axis="0 0 1"/>
    <joint name="planet3_pin" type="hinge" body1="planet3" body2="carrier" anchor="-0.095 0.45 0" axis="0 0 1"/>
    <joint name="planet4_pin" type="hinge" body1="planet4" body2="carrier" anchor="0 0.355 0" axis="0 0 1"/>
    <joint name="sun_planet1" type="gear" body1="sun" body2="planet1" anchor="0 0.45 0" axis="0 0 1" ratio="0.72727" anchor2="0.095 0.45 0" axis2="0 0 1"/>
    <joint name="planet1_ring" type="gear" body1="planet1" body2="ring" anchor="0.095 0.45 0" axis="0 0 1" ratio="0.36667" epicyclic="true" anchor2="0 0.45 0" axis2="0 0 1"/>
    <joint name="sun_planet2" type="gear" body1="sun" body2="planet2" anchor="0 0.45 0" axis="0 0 1" ratio="0.72727" anchor2="0 0.545 0" axis2="0 0 1"/>
    <joint name="planet2_ring" type="gear" body1="planet2" body2="ring" anchor="0 0.545 0" axis="0 0 1" ratio="0.36667" epicyclic="true" anchor2="0 0.45 0" axis2="0 0 1"/>
    <joint name="sun_planet3" type="gear" body1="sun" body2="planet3" anchor="0 0.45 0" axis="0 0 1" ratio="0.72727" anchor2="-0.095 0.45 0" axis2="0 0 1"/>
    <joint name="planet3_ring" type="gear" body1="planet3" body2="ring" anchor="-0.095 0.45 0" axis="0 0 1" ratio="0.36667" epicyclic="true" anchor2="0 0.45 0" axis2="0 0 1"/>
    <joint name="sun_planet4" type="gear" body1="sun" body2="planet4" anchor="0 0.45 0" axis="0 0 1" ratio="0.72727" anchor2="0 0.355 0" axis2="0 0 1"/>
    <joint name="planet4_ring" type="gear" body1="planet4" body2="ring" anchor="0 0.355 0" axis="0 0 1" ratio="0.36667" epicyclic="true" anchor2="0 0.45 0" axis2="0 0 1"/>
  </equality>
  <events/>
  <control>
    <controller formula="planetary" period="0"/>
    <param name="sun_rpm" value="60" min="-120" max="120" step="1" label="太陽歯車 A (rpm)"/>
    <param name="ring_rpm" value="0" min="-120" max="120" step="1" label="内歯車 C (rpm、0 = 固定)"/>
    <chart title="回転数 (rpm)" signals="planetary/scope:sun_rpm planetary/scope:ring_rpm planetary/scope:carrier_rpm planetary/scope:carrier_theory_rpm" span="20"/>
    <chart title="遊星歯車の自転 (rpm、キャリヤから見て)" signals="planetary/scope:planet_rpm planetary/scope:planet_theory_rpm" span="20"/>
    <chart title="変速比（太陽 / キャリヤ）" signals="planetary/scope:ratio" span="20"/>
  </control>
</wizengine>
