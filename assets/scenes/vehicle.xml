<?xml version="1.0" encoding="UTF-8"?>
<!-- 車両シミュレーションのサンプル。アセットパネルの保存済みシーンから
     読み込み（またはコピーして起動シーンに）、シミュレートを開始して
     W / S / A / D（前・後ろ / 左右）、Space（ハンドブレーキ）で運転する。
     車体は箱 1 個で、車輪は剛体ではなくレイキャスト式（見た目は円柱 +
     スポークを描画側で重ねる）。
     <vehicle> の書式は src/vehicle/VehicleXml.h。 -->
<wizengine model="vehicle" version="4">
  <asset>
    <event name="pickup">
      <node id="1" type="onGrab" pos="40 40" target="-1"/>
      <node id="2" type="grabPull" pos="300 40" target="-1" value="1"/>
      <wire from="1" to="2"/>
    </event>
    <!-- カメラ追従（Camera 1）: 共通イベント（イベントライブラリ）の
         assets/events/follow_car.xml を参照する（中身はそのファイル。terrain.xml
         と共用）。下の車体に付けてある。 -->
    <event name="follow_car" file="events/follow_car.xml"/>
    <!-- プレハブ（🧩）: 階段の全段。付け先（geom の無いボディ）のローカル座標で、
         原点は全体が収まる箱（幅 3 × 高さ 0.72 × 奥行き 9 m）の中心。+Z 側から
         -Z へ 0.5 m ごとに 0.12 m ずつ上り、踊り場（3 m）を挟んで下る。各段は
         床から段の高さまでの中実の箱。collide="true" なので当たり判定を持つ
         （質量は body の mass。固定なので効かない）。 -->
    <prefab name="stairs">
      <part name="up0" type="box" pos="0 -0.3 4.25" size="3 0.12 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="up1" type="box" pos="0 -0.24 3.75" size="3 0.24 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="up2" type="box" pos="0 -0.18 3.25" size="3 0.36 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="up3" type="box" pos="0 -0.12 2.75" size="3 0.48 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="up4" type="box" pos="0 -0.06 2.25" size="3 0.6 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="up5" type="box" pos="0 0 1.75" size="3 0.72 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="landing" type="box" pos="0 0 0" size="3 0.72 3" rgba="0.58 0.6 0.64 1" collide="true"/>
      <part name="down0" type="box" pos="0 0 -1.75" size="3 0.72 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="down1" type="box" pos="0 -0.06 -2.25" size="3 0.6 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="down2" type="box" pos="0 -0.12 -2.75" size="3 0.48 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="down3" type="box" pos="0 -0.18 -3.25" size="3 0.36 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="down4" type="box" pos="0 -0.24 -3.75" size="3 0.24 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
      <part name="down5" type="box" pos="0 -0.3 -4.25" size="3 0.12 0.5" rgba="0.62 0.64 0.68 1" collide="true"/>
    </prefab>
    <!-- 制御器の見本（🧮 + World タブの「制御器」節）: クルーズコントロール。
         車速 vehicle:car.speed を目標 8 m/s（約 29 km/h。変化率 2 m/s² で
         立ち上げる）へ PID で寄せ、正ならアクセル、負ならブレーキへ振り分ける。
         書いた項目（アクセル・ブレーキ）だけがキーボードの入力を置き換える
         ので、ハンドル（A / D）は手で切れる。既定は止めてある（下の
         <control> の enabled="false"）- World タブのチェックで入れる。 -->
    <formula name="cruise">
      <node id="1" type="const" params="8" pos="40 40"/>
      <node id="2" type="ratelimit" params="2 2" pos="260 40"/>
      <node id="3" type="in" name="vehicle:car.speed" pos="40 200"/>
      <node id="4" type="sub" pos="480 100"/>
      <node id="5" type="pid" params="0.4 0.15 0 -1 1 0" pos="700 100"/>
      <node id="6" type="saturate" params="0 1" pos="920 40"/>
      <node id="7" type="neg" pos="920 200"/>
      <node id="8" type="saturate" params="0 1" pos="1140 200"/>
      <node id="9" type="out" name="vehicle:car.throttle" pos="1140 40"/>
      <node id="10" type="out" name="vehicle:car.brake" pos="1360 200"/>
      <node id="11" type="out" name="scope:ref" pos="480 300"/>
      <node id="12" type="out" name="scope:speed" pos="480 380"/>
      <wire from="1" to="2"/>
      <wire from="2" to="4"/>
      <wire from="3" to="4" port="1"/>
      <wire from="4" to="5"/>
      <wire from="5" to="6"/>
      <wire from="5" to="7"/>
      <wire from="7" to="8"/>
      <wire from="6" to="9"/>
      <wire from="8" to="10"/>
      <wire from="2" to="11"/>
      <wire from="3" to="12"/>
    </formula>
  </asset>
  <worldbody>
    <environment hdr="studio.hdr" intensity="30000"/>
    <ground size="60" visual="60" texture="textures/ground.png" tile="2" rgba="1 1 1 1"/>
    <camera name="cam0" target="0 0.7 0" azimuth="150" elevation="18" radius="9"/>
    <!-- Camera 1: 車の追従用（イベント follow_car が後ろに付ける）。編集は
         Camera 0（Editor Camera）のまま。ここの姿勢は走らせる前と止めた後の視点。 -->
    <camera name="cam1" target="0 0.7 0" azimuth="0" elevation="14" radius="9"/>
    <!-- 車体: 1.4 × 0.5 × 4.2 m、1400 kg。重心高さ 0.72 m は静的な縮みを
         引いた値（サスの rest 0.35 - 縮み 0.1 + 半径 0.32 - 取り付け y -0.15）。
         トレッド 1.7 m は車体幅より広く、タイヤが横にはみ出して見える。 -->
    <body name="car" pos="0 0.77 0" euler="0 0 0">
      <geom type="box" size="0.7 0.25 2.1" mass="1400" rgba="0.85 0.2 0.15 1"/>
      <event name="follow_car"/>
      <vehicle ticks="10" brake="2500" drag="0.7">
        <engine torque="300" idle="900" max="6500" inertia="0.25"/>
        <clutch torque="500" engage="1300" full="2200"/>
        <gearbox ratios="3.6 2.1 1.4 1 0.8" reverse="3.4" final="3.9" up="5800" down="2300"/>
        <!-- soft="true" でタイヤが質点ばねの変形メッシュになり（接地面が潰れ、
             転がりながら戻る）、物理では径方向ばね stiffness (N/m) がサスと
             直列に効く（潰れ = 荷重 / stiffness。この車は 1 輪 3.4 kN で約 2.8 cm）。
             segments / rows はメッシュの分割。剛タイヤに戻すなら soft を消す。 -->
        <!-- 大きめで弾むタイヤ: 半径 0.42 m・幅 0.3 m、径方向剛性 60 kN/m
             （1 輪 3.4 kN で約 5.7 cm 潰れる）、メッシュの減衰は低めで揺れが残る。
             pressure は空気圧（ゲージ圧 Pa。320 kPa ≒ 乗用車の 3.2 bar）で、潰れて
             体積が減ると pressureFormula の式が圧力を上げ、ゴムのように張り戻す。
             0 なら空気圧の項は無し。 -->
        <axle z="1.3" y="-0.15" track="1.7" steer="32" driven="false" brake="1">
          <tire radius="0.42" width="0.3" inertia="1.8" soft="true"
                stiffness="60000" damping="0.2" segments="28" rows="4"
                pressure="320000"/>
        </axle>
        <axle z="-1.3" y="-0.15" track="1.7" driven="true" brake="0.65" handbrake="1" diff="lsd" lock="250">
          <tire radius="0.42" width="0.3" inertia="1.8" soft="true"
                stiffness="60000" damping="0.2" segments="28" rows="4"
                pressure="320000"/>
        </axle>
      </vehicle>
    </body>
    <!-- ぶつかる物 -->
    <body name="cone0" pos="0 0.3 -12">
      <geom type="box" size="0.2 0.3 0.2" mass="2" rgba="1 0.6 0.1 1"/>
    </body>
    <body name="cone1" pos="2 0.3 -18">
      <geom type="box" size="0.2 0.3 0.2" mass="2" rgba="1 0.6 0.1 1"/>
    </body>
    <body name="cone2" pos="-2 0.3 -24">
      <geom type="box" size="0.2 0.3 0.2" mass="2" rgba="1 0.6 0.1 1"/>
    </body>
    <!-- 階段（上って踊り場、下る）: 専用のオブジェクトではなく、geom を持たない
         固定ボディ（= 全体が収まる箱の中心。<geom> を書かず mass だけ）にプレハブ
         "stairs"（<asset> 参照）を付けたもの。段はすべて collide="true" の箱の
         部品で、物理では本体の複合形状、車輪のレイも同じ形に当たる。アセット
         パネルの 🪜 Stairs でも同じ流儀で置ける。 -->
    <body name="stairs" pos="6.0 0.36 -10.5" fixed="true" mass="50">
      <prefab name="stairs"/>
    </body>
    <body name="wall" pos="0 0.5 -40">
      <geom type="box" size="3 0.5 0.25" mass="200" rgba="0.5 0.5 0.55 1"/>
    </body>
  </worldbody>
  <events>
    <event name="pickup"/>
  </events>
  <control>
    <controller formula="cruise" period="0.02" enabled="false"/>
  </control>
</wizengine>
