<?xml version="1.0" encoding="UTF-8"?>
<!-- UI の見本（番号の正しくない cameras）。cameras="1 20" の 20 は存在しない
     カメラなので、この Canvas はどのカメラにも出ない（1 にも出ない）。読込で
     警告が 1 件出る（"camera 20 does not exist ... shown on no camera"）。
     比べるために、正しい Canvas（全カメラ）も 1 枚置く。 -->
<wizengine model="ui_cameras_error" version="4">
  <worldbody>
    <ground size="10" visual="8" texture="textures/ground.png" tile="2" rgba="1 1 1 1"/>
    <body name="box0" pos="0 0.5 0">
      <geom type="box" size="0.5 0.5 0.5" mass="1" rgba="0.80 0.36 0.18 1"/>
    </body>
    <canvas name="visible">
      <text id="1" pos="32 32" size="900 60" fontSize="40"
            text="この字は全カメラに出る。赤い帯はどこにも出ない（警告 1 件）。"/>
    </canvas>
    <canvas name="nowhere" cameras="1 20">
      <image id="1" anchor="0 0.5 1 0.5" pivot="0.5 0.5" size="0 120" color="1 0 0 0.8"/>
    </canvas>
  </worldbody>
</wizengine>
