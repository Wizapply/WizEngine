<?xml version="1.0" encoding="UTF-8"?>
<!-- テレインの散布物（木）の見本シーン。地形と木の配置は data の名前の
     assets/terrains/forest.terrain が持つ（配置は TREE 節）。車と物の水平の位置は
     terrain.xml と同じで、高さはこの地形に合わせた。木は車の開始位置より東の丘に
     集まっている。

     木の当たり判定は幹の円柱だけ（枝や葉には当たらない）。箱・球などの剛体と
     車体の箱は幹に当たるが、車輪のレイは幹に当たらない（車輪は幹を通り抜ける）。
     背の高い幹には車体の箱が当たって止まるが、背の低い幹（幹の高さは配置の倍率で
     変わる）は車体の下を抜けて当たらない。足元が穴の配置は幹の当たり判定を持たない。

     木のモデルは同梱していない。原型にモデルを指定しない / ファイルが無いときは
     代役（円柱の幹 + 球の冠）で描く。モデルの置き方は assets/README.md。 -->
<wizengine model="forest" version="4">
  <option gravity="0 -9.81 0" rate="60" substeps="2" iterations="60" envelope="0.002"
          recovery="0.2" friction="0.6" restitution="0" lineardamping="0.15"
          angulardamping="0.6" sleeping="true" integrator="euler" solver="bb" combine="min"
          contact="nsc"/>
  <visual>
    <quality shadowMap="2048" cascades="3" shadow="pcf" contactShadows="false" msaa="4"
             taa="false" fxaa="true"/>
    <postprocess enabled="true" ssao="true" ssaoIntensity="1" bloom="0.04" ssr="false" dof="0"
                 dofBlur="1" vignette="0.2"/>
    <exposure aperture="16" shutter="125" sensitivity="100"/>
    <grading tonemap="aces" contrast="1.05" saturation="1.05" temperature="0" tint="0"/>
  </visual>
  <asset>
    <event name="pickup">
      <node id="1" type="onGrab" pos="40 40" target="-1"/>
      <node id="2" type="grabPull" pos="300 40" target="-1" value="1"/>
      <wire from="1" to="2"/>
    </event>
    <event name="follow_car" file="events/follow_car.xml"/>
    <prefab name="dumbbell">
      <part name="bar" type="cylinder" pos="0 0 0" euler="0 0 0" size="1.3 0.12 0.12"
            rgba="0.55 0.57 0.6 1" roughness="0.35" metallic="1"/>
      <part name="weightL" type="sphere" pos="-0.65 0 0" euler="0 0 0" size="0.6 0.6 0.6"
            rgba="0.85 0.3 0.55 1" collide="true"/>
      <part name="weightR" type="sphere" pos="0.65 0 0" euler="0 0 0" size="0.6 0.6 0.6"
            rgba="0.85 0.3 0.55 1" collide="true"/>
    </prefab>
  </asset>
  <worldbody>
    <environment hdr="studio.hdr" intensity="30000" skybox="false"/>
    <ground enabled="false" size="10" visual="8" texture="textures/ground.png" tile="2"
            rgba="1 1 1 1" roughness="0.9" metallic="0"/>
    <terrain data="forest" guid="5570958d270ae6cfb3fff4c64acf8927" pos="0 0.05 0"
             rgba="0.55 0.68 0.42 1" roughness="0.9" metallic="0"/>
    <light name="sun" type="directional" pos="0 30 0" euler="50 -35 0" diffuse="1 0.97 0.92 1"
           intensity="100000" falloff="25" inner="25" cutoff="35" castshadow="true"/>
    <light name="sky" type="directional" pos="0 25 0" euler="30 150 0" diffuse="0.8 0.87 1 1"
           intensity="20000" falloff="25" inner="25" cutoff="35" castshadow="false"/>
    <camera name="cam0" target="0 5 -20" azimuth="-70" elevation="20" radius="60" active="true"/>
    <camera name="cam1" target="-25 3.5 -30" azimuth="-20" elevation="15" radius="11"
            active="true"/>
    <camera name="cam2" target="0 1 0" azimuth="37.8152" elevation="65.8901" radius="10"
            active="false"/>
    <camera name="cam3" target="0 1 0" azimuth="37.8152" elevation="19.4806" radius="12"
            active="false"/>
    <camera name="cam4" target="0 1 0" azimuth="37.8152" elevation="19.4806" radius="12"
            active="false"/>
    <body name="car" pos="-25 4.1 -28" euler="0 0 0" fixed="false">
      <geom type="box" size="0.7 0.25 2.1" mass="1400" rgba="0.85 0.2 0.15 1"/>
      <event name="follow_car"/>
      <vehicle ticks="10" brake="2500" drag="0.7" steerRate="4" steerSpeed="12" tcs="0.25"
               pedalRate="6">
        <engine torque="300" idle="900" max="6500" inertia="0.25" friction="0.03"
                frictionConst="10"/>
        <clutch torque="500" engage="1300" full="2200"/>
        <gearbox ratios="3.6 2.1 1.4 1 0.8" reverse="3.4" final="3.9" efficiency="0.92"
                 up="5800" down="2300" time="0.25" automatic="true"/>
        <center type="open" bias="0.5" stiffness="20" lock="300"/>
        <axle z="1.3" y="-0.15" track="1.7" steer="32" ackermann="1" driven="false" brake="1"
              handbrake="0" diff="open" stiffness="20" lock="300">
          <tire radius="0.42" width="0.3" inertia="1.8" mu="1.2" bx="12" cx="1.65" ex="0.97"
                by="12" cy="1.4" ey="-1" relax="0.15" rolling="0.015" rays="9"
                soft="true" stiffness="60000" damping="0.2" segments="28" rows="4"
                iterations="3" pressure="320000"/>
          <suspension rest="0.35" travel="0.25" stiffness="35000" bump="3500" rebound="4500"
                      antiroll="6000"/>
        </axle>
        <axle z="-1.3" y="-0.15" track="1.7" steer="0" ackermann="1" driven="true" brake="0.65"
              handbrake="1" diff="lsd" stiffness="20" lock="250">
          <tire radius="0.42" width="0.3" inertia="1.8" mu="1.2" bx="12" cx="1.65" ex="0.97"
                by="12" cy="1.4" ey="-1" relax="0.15" rolling="0.015" rays="9"
                soft="true" stiffness="60000" damping="0.2" segments="28" rows="4"
                iterations="3" pressure="320000"/>
          <suspension rest="0.35" travel="0.25" stiffness="35000" bump="3500" rebound="4500"
                      antiroll="6000"/>
        </axle>
      </vehicle>
    </body>
    <body name="slider0" pos="8 6.39 -28" euler="0 0 0" fixed="false">
      <geom type="box" size="0.3 0.3 0.3" mass="20" rgba="0.8 0.36 0.18 1" friction="0.1"/>
    </body>
    <body name="slider1" pos="12 6.66 -30" euler="0 0 0" fixed="false">
      <geom type="box" size="0.3 0.3 0.3" mass="20" rgba="0.82 0.46 0.16 1" friction="0.1"/>
    </body>
    <body name="slider2" pos="0 5.91 -20" euler="0 0 0" fixed="false">
      <geom type="box" size="0.3 0.3 0.3" mass="20" rgba="0.76 0.42 0.2 1" friction="0.1"/>
    </body>
    <body name="sticker" pos="5 6.65 -15" euler="0 0 0" fixed="false">
      <geom type="box" size="0.3 0.3 0.3" mass="20" rgba="0.45 0.45 0.5 1"/>
    </body>
    <body name="ball0" pos="2 6.6 -10" euler="0 0 0" fixed="false">
      <geom type="sphere" size="0.35" mass="5" rgba="0.29 0.56 0.85 1"/>
    </body>
    <body name="ball1" pos="0 6.45 -5" euler="0 0 0" fixed="false">
      <geom type="sphere" size="0.35" mass="5" rgba="0.29 0.56 0.85 1"/>
    </body>
    <body name="ball2" pos="-3 5.72 -18" euler="0 0 0" fixed="false">
      <geom type="sphere" size="0.35" mass="5" rgba="0.95 0.85 0.2 1"/>
    </body>
    <body name="ball3" pos="10 7.05 -20" euler="0 0 0" fixed="false">
      <geom type="sphere" size="0.35" mass="5" rgba="0.95 0.85 0.2 1"/>
    </body>
    <body name="softball" pos="5 7.05 -10" euler="0 0 0" fixed="false">
      <geom type="sphere" size="0.4" mass="3" rgba="0.3 0.75 0.45 1"/>
      <soft res="4" stiffness="4000" damping="0.3" shear="1" bend="0.5" iterations="2"/>
    </body>
    <body name="dumbbell" pos="4 6.17 -24" euler="0 90 0" fixed="false" mass="10">
      <prefab name="dumbbell"/>
    </body>
  </worldbody>
  <events>
    <event name="pickup"/>
  </events>
</wizengine>
