<?xml version="1.0" encoding="UTF-8"?>
<!-- 制御器（ブロック線図）の見本。シミュレートすると:
       * arm_pid … トルクモータ付きの腕 (arm) を PID で目標角へ追従させる。
                   目標は時刻の折れ線（0 → 0.6 → -0.4 → 1.2 rad の階段）を
                   変化率制限 2 rad/s で滑らかにしたもの。
       * hover   … 箱 (hover) を上向きの力で浮かせ、高さを PID で保つ
                   （重力ぶんは m g の前向き補償）。目標高さは 1 → 2.5 → 1.5 m。
     World タブの「制御器」節の 📈 でスコープを開くと、目標・測定値・操作量が
     時系列で見える（CSV でも落とせる）。ゲインは 3 重極の配置（腕: 慣性
     約 1.26 kg m² で ω = 5 rad/s、箱: 2 kg で ω = 4 rad/s。J s³ + kd s² + kp s
     + ki = J (s + ω)³）。ノードエディタの pid ノードの
     欄（kp ki kd lo hi tf）を書き換えれば、走らせたままでも効く。
     信号名の約束は src/control/ControlSignals.h、ブロックは src/vehicle/Formula.h。 -->
<wizengine model="control_arm" version="4">
  <option gravity="0 -9.81 0" rate="120" substeps="2" iterations="80" envelope="0.002"
          recovery="0.2" friction="0.6" restitution="0" lineardamping="0"
          angulardamping="0" sleeping="false"/>
  <asset>
    <formula name="arm_pid">
      <node id="1" type="time" pos="40 40"/>
      <node id="2" type="curve" params="0 0 1 0 1.001 0.6 4 0.6 4.001 -0.4 7 -0.4 7.001 1.2 10 1.2" pos="260 40"/>
      <node id="3" type="ratelimit" params="2 2" pos="480 40"/>
      <node id="4" type="in" name="joint:shoulder.angle" pos="40 220"/>
      <node id="5" type="sub" pos="700 120"/>
      <node id="6" type="pid" params="95 160 19 -40 40 0.01" pos="920 120"/>
      <node id="7" type="out" name="joint:shoulder.target" pos="1160 120"/>
      <node id="8" type="out" name="scope:ref" pos="700 300"/>
      <node id="9" type="out" name="scope:angle" pos="700 380"/>
      <node id="10" type="out" name="scope:torque" pos="1160 260"/>
      <wire from="1" to="2"/>
      <wire from="2" to="3"/>
      <wire from="3" to="5"/>
      <wire from="4" to="5" port="1"/>
      <wire from="5" to="6"/>
      <wire from="6" to="7"/>
      <wire from="3" to="8"/>
      <wire from="4" to="9"/>
      <wire from="6" to="10"/>
    </formula>
    <formula name="hover">
      <node id="1" type="time" pos="40 40"/>
      <node id="2" type="curve" params="0 1 2 1 2.001 2.5 6 2.5 6.001 1.5 10 1.5" pos="260 40"/>
      <node id="11" type="ratelimit" params="1 1" pos="480 40"/>
      <node id="3" type="in" name="body:hover.y" pos="40 200"/>
      <node id="4" type="sub" pos="700 100"/>
      <node id="5" type="pid" params="96 128 24 -40 40 0.01" pos="920 100"/>
      <!-- 重力の補償（2 kg × 9.81） -->
      <node id="6" type="const" params="19.62" pos="920 260"/>
      <node id="7" type="add" pos="1160 160"/>
      <node id="8" type="out" name="body:hover.fy" pos="1380 160"/>
      <node id="9" type="out" name="scope:ref" pos="700 300"/>
      <node id="10" type="out" name="scope:height" pos="700 380"/>
      <wire from="1" to="2"/>
      <wire from="2" to="11"/>
      <wire from="11" to="4"/>
      <wire from="3" to="4" port="1"/>
      <wire from="4" to="5"/>
      <wire from="5" to="7"/>
      <wire from="6" to="7" port="1"/>
      <wire from="7" to="8"/>
      <wire from="11" to="9"/>
      <wire from="3" to="10"/>
    </formula>
  </asset>
  <worldbody>
    <ground size="12" visual="10" tile="2"/>
    <light name="key" type="sun" pos="0 8 0" euler="35 -25 0" intensity="100000" castshadow="true"/>
    <light name="fill" type="point" pos="-3 4 3" intensity="60000" falloff="20" castshadow="false"/>
    <camera name="cam0" target="0 1.5 0" azimuth="20" elevation="12" radius="8"/>

    <!-- 腕: 柱の上にちょうつがい（Z 軸）で留め、先に球。トルクモータで駆動 -->
    <body name="post" pos="-1 1 0" fixed="true">
      <geom type="box" size="0.08 1 0.08" mass="10" rgba="0.4 0.42 0.48 1"/>
    </body>
    <body name="arm" pos="-0.4 2 0">
      <geom type="box" size="0.6 0.04 0.04" mass="1" rgba="0.9 0.5 0.2 1"/>
    </body>
    <body name="tip" pos="0.25 2 0">
      <geom type="sphere" size="0.1" mass="0.5" rgba="0.3 0.6 0.9 1"/>
    </body>

    <!-- 浮く箱: 力で高さを保つ（推力の向きはワールドの +Y） -->
    <body name="hover" pos="2 1 0">
      <geom type="box" size="0.25 0.1 0.25" mass="2" rgba="0.55 0.8 0.35 1"/>
    </body>
  </worldbody>
  <equality>
    <joint name="shoulder" type="hinge" body1="arm" body2="post" anchor="-1 2 0" axis="0 0 1"
           motor="force" target="0"/>
    <joint name="arm_tip" type="weld" body1="tip" body2="arm" anchor="0.2 2 0" axis="0 1 0"/>
  </equality>
  <control>
    <controller formula="arm_pid" period="0"/>
    <controller formula="hover" period="0.01"/>
  </control>
</wizengine>
