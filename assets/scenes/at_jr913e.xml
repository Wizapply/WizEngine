      <source line="#   1 = 全開加速  … 1 s 後に全開、30 s でアクセルを戻してブレーキ"/>
      <source line="#   2 = 市街地    … 発進（開度 0.3）→ 巡航（0.15）→ キックダウン（全開）→ 惰行 → ブレーキで停止"/>
      <source line="#   3 = ストール  … ブレーキを踏んだまま全開（トルコンのストール回転とトルク比を見る）"/>
      <source line="prog = param:program"/>
      <source line="t = time"/>
      <source line="rpm = trans:jr913e.engine_rpm"/>
      <source line="kmh = trans:jr913e.speed_kmh"/>
      <source line=""/>
      <source line="th_wot = (t &gt; 1) * (t &lt; 30)"/>
      <source line="br_wot = (t &gt; 30) * 0.25"/>
      <source line="th_city = curve(t, 0, 0, 1, 0, 1.05, 0.3, 10, 0.3, 10.05, 0.15, 25, 0.15, 25.05, 1, 32, 1, 32.05, 0, 100, 0)"/>
      <source line="br_city = curve(t, 0, 0, 45, 0, 45.05, 0.12, 100, 0.12)"/>
      <source line="th = select(prog &lt; 0.5, param:throttle, select(prog &lt; 1.5, th_wot, select(prog &lt; 2.5, th_city, t &gt; 1)))"/>
      <source line="br = select(prog &lt; 0.5, param:brake, select(prog &lt; 1.5, br_wot, select(prog &lt; 2.5, br_city, 1)))"/>
      <source line="# 手動以外はいつも D"/>
      <source line="sel = select(prog &lt; 0.5, param:shifter, 3)"/>
      <source line=""/>
      <source line="# ---- エンジン（燃焼・摩擦込みの正味のトルク。アイドル制御と燃料カットは AT の &lt;engine&gt; が持つ）"/>
      <source line="wot = curve(rpm, 0, 0, 800, 200, 1000, 267, 1250, 349, 1500, 431, 1600, 462, 1700, 472, 1800, 475, 5600, 475, 5800, 470, 6000, 464, 6200, 457, 6400, 445, 6600, 418, 6850, 378, 7000, 354)"/>
      <source line="fric = 12 + 0.004 * rpm + 0.0000012 * rpm * rpm"/>
      <source line="tq = th * min(wot, 220) + lag(th * max(wot - 220, 0), 0.35) - fric"/>
      <source line=""/>
      <source line="trans:jr913e.engine_torque = tq"/>
      <source line="trans:jr913e.throttle = th"/>
      <source line="trans:jr913e.brake = br"/>
      <source line="trans:jr913e.select = sel"/>
      <source line="trans:jr913e.manual = param:manual"/>
      <source line="trans:jr913e.grade = atan(param:grade / 100)"/>
      <source line=""/>
