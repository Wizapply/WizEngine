<?xml version="1.0" encoding="UTF-8"?>
<!-- UI（Canvas）の見本。確かめる点:
       * 日本語の字（大きい字・小さい字・画数の多い漢字）が潰れずに出るか
       * 縁取り（outline / outlineColor）と、半透明の板・字
       * 画像（textures/ground.png）
       * 右下に寄せた要素が、ページの縦横比を変えても右下に残るか
       * 共用 UI（<canvas ui="hud"> = assets/ui/hud.xml）
       * cameras="1" の Canvas が Camera 1 のページにだけ出るか
       * 3D の板（sign = world、camera_plate = camera）: 物に隠れる・カメラに付く・押せる
       * 後処理（ブルーム・ビネット）が overlay の UI に掛からないか（板には掛かる）
       * ボタン（下の中央）: シミュレート中に上に乗せると hover の色、押している間は
         pressed の色になり、ボタンの上で離すと左上の見出しの字が変わるか（イベント
         start_heading = onUiClick → setUiProp。シミュレートを止めると元の字に戻る）。
         エディタ中は押せず、Text / Image と同じく選んで動かせるか
     字は同梱の Noto Sans JP（assets/fonts/、<font> を書かなければこれ）。 -->
<wizengine model="ui" version="4">
  <!-- 後処理を効かせる（ブルーム・ビネット・ACES）。UI はこれの影響を受けない
       （後処理を切った 2 枚目のビューに描く）ことを確かめる。 -->
  <visual>
    <quality shadowMap="2048" cascades="3" shadow="pcss" msaa="4" fxaa="true"/>
    <postprocess enabled="true" ssao="true" bloom="0.3" vignette="0.35"/>
    <grading tonemap="aces" contrast="1.05" saturation="1.02"/>
  </visual>
  <asset>
    <ui name="hud" file="ui/hud.xml"/>
    <!-- マウスで掴んだ物をカーソルへ引き寄せる（イベントの節を書くと既定では付かないので
         default.xml と同じものを書く）。 -->
    <event name="pickup">
      <node id="1" type="onGrab" pos="40 40" target="-1"/>
      <node id="2" type="grabPull" pos="300 40" target="-1" value="1"/>
      <wire from="1" to="2"/>
    </event>
    <!-- ボタン start（Canvas 4 = buttons）を押したら、左上の板（Canvas 0 = title）の
         見出し heading の字を変える。値は性質の型で決まる欄（text の性質は text 属性）。 -->
    <event name="start_heading">
      <node id="1" type="onUiClick" pos="40 40" target="4" element="start"/>
      <node id="2" type="setUiProp" pos="300 40" target="0" element="heading" prop="text"
            text="スタート！"/>
      <wire from="1" to="2"/>
    </event>
    <!-- 3D の看板（Canvas 5 = sign）のボタン push を押したら、同じ看板の見出しの字を変える。 -->
    <event name="sign_button">
      <node id="1" type="onUiClick" pos="40 40" target="5" element="push"/>
      <node id="2" type="setUiProp" pos="300 40" target="5" element="heading" prop="text"
            text="押されました"/>
      <wire from="1" to="2"/>
    </event>
  </asset>
  <worldbody>
    <environment hdr="studio.hdr" intensity="30000"/>
    <ground size="10" visual="8" texture="textures/ground.png" tile="2" rgba="1 1 1 1"/>
    <body name="box0" pos="0 0.5 0" euler="0 20 0">
      <geom type="box" size="0.5 0.5 0.5" mass="1" rgba="0.80 0.36 0.18 1"/>
    </body>
    <body name="ball0" pos="1.4 0.4 0.6">
      <geom type="sphere" size="0.4" mass="1" rgba="0.2 0.45 0.8 1"/>
    </body>

    <!-- 左上: 見出し・説明（折り返し）・画数の多い漢字・小さい字。説明は 28 px で
         3 行（1 行約 41 px = 約 122 px）なので、漢字の行はその下（y 252）から。 -->
    <canvas name="title" order="1">
      <image id="1" name="panel" pos="32 32" size="760 364" color="0 0 0 0.4"/>
      <text id="2" parent="1" name="heading" pos="28 20" size="704 80" text="Charon の UI"
            fontSize="64" outline="0.08" outlineColor="0.05 0.08 0.2 1"
            color="1 0.92 0.6 1"/>
      <text id="3" parent="1" name="body" pos="28 112" size="704 128" wrap="true"
            text="日本語の文字を、輪郭までの距離の画像（SDF）で描いています。拡大しても縁がなめらかなままか、折り返しが正しいかを見てください。"
            fontSize="28"/>
      <text id="4" parent="1" name="kanji" pos="28 252" size="704 56"
            text="鬱・薔薇・齟齬・驚愕・憂鬱・魑魅魍魎" fontSize="36"/>
      <text id="5" parent="1" name="small" pos="28 316" size="704 30"
            text="小さい字（14 px）: 画数の多い漢字「鬱」「麤」も潰れずに読めますか？"
            fontSize="14" color="0.85 0.85 0.85 1"/>
    </canvas>

    <!-- 左下: 画像（半透明）と、その上の字 -->
    <canvas name="image" order="0">
      <image id="1" name="thumb" anchor="0 1 0 1" pivot="0 1" pos="32 -32" size="256 256"
             file="textures/ground.png" color="1 1 1 0.85"/>
      <text id="2" parent="1" name="caption" anchor="0 1 1 1" pivot="0 1" pos="12 -12"
            size="-24 40" text="画像 textures/ground.png" fontSize="22"
            outline="0.1" outlineColor="0 0 0 0.9"/>
    </canvas>

    <!-- 右下: 共用 UI（assets/ui/hud.xml） -->
    <canvas name="hud" ui="hud" order="2"/>

    <!-- 右上の隅: Camera 1 のページにだけ出る小さな字（カメラごとの出し分けの見本） -->
    <canvas name="camera1" cameras="1" order="3">
      <text id="1" name="label" anchor="1 0 1 0" pivot="1 0" pos="-24 20" size="240 32"
            text="Camera 1" fontSize="22" align="right" color="1 1 1 0.45"/>
    </canvas>

    <!-- 下の中央: ボタン（字は縦横とも中央。色は背景、textColor が字） -->
    <canvas name="buttons" order="4">
      <button id="1" name="start" anchor="0.5 1 0.5 1" pivot="0.5 1" pos="0 -40" size="280 72"
              text="押してみる" fontSize="30" align="center" color="0.18 0.42 0.85 1"
              hover="0.3 0.55 0.95 1" pressed="0.1 0.28 0.6 1" textColor="1 1 1 1"/>
    </canvas>

    <!-- 3D の空間の板（Canvas 5、mode="world"）: 箱 box0 のすぐ後ろ（z -0.8）に立てた
         1.6 × 1.2 m の看板（床から 0.1〜1.3 m、1 m = 900 画素）。下の段の字「下の方は…」が
         手前の箱に隠れるか（手前の物に隠れる）、後処理（ブルーム・トーンマップ）が掛かるかを
         見る。ボタン（右上、床から約 1.1〜1.26 m）は箱の上端（1 m）より上なので、正面からも
         斜め上からも箱に隠れない（隠れた板の当たりは見ない = 箱の後ろにボタンを置くと箱を
         掴めなくなるため）。シミュレート中にボタンを押すと見出しの字が変わる（イベント
         sign_button）。 -->
    <canvas name="sign" mode="world" pos="0 0.7 -0.8" euler="0 0 0" size="1.6 1.2">
      <image id="1" name="board" anchor="0 0 1 1" pos="0 0" size="0 0" color="0.05 0.08 0.15 0.85"/>
      <text id="2" name="heading" pos="40 40" size="760 140" text="3D の看板" fontSize="110"
            color="1 0.92 0.6 1"/>
      <button id="3" name="push" anchor="1 0 1 0" pivot="1 0" pos="-40 40" size="520 140"
              text="板のボタン" fontSize="64" align="center" color="0.18 0.42 0.85 1"
              hover="0.3 0.55 0.95 1" pressed="0.1 0.28 0.6 1" textColor="1 1 1 1"/>
      <text id="4" name="hidden" anchor="0 1 1 1" pivot="0 1" pos="40 -40" size="-80 300"
            wrap="true" text="下の方は手前の箱に隠れます" fontSize="80" align="center"
            color="0.85 0.85 0.85 1"/>
    </canvas>

    <!-- カメラの前の板（Canvas 6、mode="camera"）: Camera 1 のページにだけ、視点の 1.5 m 前に
         出る半透明の帯。カメラを回しても遅れずに付いてくるか、物の手前に出るかを見る。 -->
    <canvas name="camera_plate" mode="camera" cameras="1" distance="1.5" size="0.8 0.12"
            height="240">
      <image id="1" name="band" anchor="0 0 1 1" pos="0 0" size="0 0" color="0 0 0 0.45"/>
      <text id="2" name="label" anchor="0 0 1 1" pos="0 0" size="0 0"
            text="Camera 1 の前の板" fontSize="96" align="center" color="1 1 1 0.9"/>
    </canvas>
  </worldbody>
  <events>
    <event name="pickup"/>
    <event name="start_heading"/>
    <event name="sign_button"/>
  </events>
</wizengine>
