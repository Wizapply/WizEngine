// Unlit material for the grab line. Unlit because the line is a UI element
// that happens to live in 3D - shading it would make it fade in shadow, which
// is exactly when the user needs to see it.
//
// culling : none は太いギズモ線のため。Filament には線の太さが無いので、
// 太い線は「直交する 2 枚の板」として三角形で描いている。板は向きを選ばず
// 見えてほしいので、裏面を落とされると困る（LINES には影響しない）。
material {
    name : line,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    culling : none,
    parameters : [
        { type : float4, name : baseColor }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.baseColor;
    }
}
